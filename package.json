{
  "name": "@singh-gur/pi-session-sync",
  "version": "0.1.0",
  "description": "Pi extension: sync your pi sessions across machines through a private git repo, with per-machine path mapping and branch-preserving merges.",
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "pack:check": "pnpm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singh-gur/pi-session-sync.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "session",
    "sync",
    "git",
    "multi-machine",
    "backup",
    "sessions"
  ],
  "author": "singh-gur",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/singh-gur/pi-session-sync/issues"
  },
  "homepage": "https://github.com/singh-gur/pi-session-sync#readme",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/singh-gur/pi-session-sync/main/assets/hero.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@12.3.4"
}
